<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gantry_engineer">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import gantry_engineer urdf file -->
    <xacro:include filename="$(find model)/urdf/gantry_engineer.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="gantry_engineer.ros2_control.xacro" />


    <xacro:gantry_engineer_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
