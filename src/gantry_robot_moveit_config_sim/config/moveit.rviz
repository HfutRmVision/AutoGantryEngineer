Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
        - /Motion Planning Tasks1
        - /TF1
        - /TF1/Frames1
      Splitter Ratio: 0.5
    Tree Height: 235
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: moveit_task_constructor/Motion Planning Tasks
    Global Settings:
      Task View Settings:
        Old task handling: Keep
        Show Computation Times: true
        Task Expansion: All Expanded
    Name: Motion Planning Tasks
    Tasks View:
      property_splitter:
        - 631
        - 210
      solution_sorting:
        column: 0
        order: 1
      solutions_splitter:
        - 339
        - 169
      solutions_view_columns: ~
      tasks_view_columns:
        - 108
        - 71
        - 71
        - 71
