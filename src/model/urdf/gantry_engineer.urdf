<?xml version="1.0"?>
<robot name="gantry_engineer">
  <link name="world" />
  <link name="eef_right_center" />
  <link name="eef_left_center" />
  <link name="floor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="2 2 0.01" />
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="2 2 0.01" />
      </geometry>
    </collision>
  </link>

  <joint name="world_to_floor" type="fixed">
    <parent link="world" />
    <child link="floor" />
    <origin xyz="0 0 -0.006" rpy="0 0 0" />
  </joint>

  <!-- IPM (Imaginary Point Marker) - 参考点 -->
  <link name="ipm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.01" />
      </geometry>
      <material name="marker-material">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="world_to_ipm" type="fixed">
    <parent link="world" />
    <child link="ipm" />
    <origin xyz="0.0 0.0 0.0" rpy="0 0 3.141593" />
  </joint>

  <link name="x_rail">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="x_rail_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_rail"/>
    <origin xyz="-0.20000 0.000000 0.000000" rpy="0.000000 0.000000 3.141593"/>
    <axis xyz="1.000000 0.000000 0.000000"/>
    <limit lower="-0.400000" upper="0.200000" effort="1000.000000" velocity="0.500000"/>
  </joint>

  <joint name="x_rail_to_link1" type="fixed">
    <parent link="x_rail"/>
    <child link="link1"/>
    <origin xyz="0.100000 0.000000 0.0000000" rpy="0.000000 0.000000 0.000000"/>
  </joint>
  
  <link name="link1">
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
